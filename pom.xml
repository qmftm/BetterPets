<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>kr.qmftm</groupId>
  <artifactId>betterpets</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>BetterPets</name>
  <description>악어의 놀이터 2 스타일 펫 시스템 — BetterModel 기반 Paper 플러그인</description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <!-- BetterModel 3.4.1 은 클래스 파일 버전 69(Java 25)로 배포된다.
         JDK 24 이하로는 컴파일 자체가 불가능하다. -->
    <maven.compiler.release>25</maven.compiler.release>

    <paper.version>26.2.build.121-stable</paper.version>
    <bettermodel.version>3.4.1</bettermodel.version>
    <placeholderapi.version>2.11.6</placeholderapi.version>
    <junit.version>5.13.0</junit.version>
  </properties>

  <repositories>
    <repository>
      <id>papermc</id>
      <url>https://repo.papermc.io/repository/maven-public/</url>
    </repository>
    <!-- BetterModel 의 전이 의존성이 여기 있다. 빼면 해결에 실패한다. -->
    <repository>
      <id>blamejared</id>
      <url>https://maven.blamejared.com/</url>
    </repository>
    <repository>
      <id>nucleoid</id>
      <url>https://maven.nucleoid.xyz/</url>
    </repository>
    <!-- PlaceholderAPI. 메이븐 센트럴에 없다. -->
    <repository>
      <id>extendedclip</id>
      <url>https://repo.extendedclip.com/releases/</url>
    </repository>
  </repositories>

  <dependencies>
    <dependency>
      <groupId>io.papermc.paper</groupId>
      <artifactId>paper-api</artifactId>
      <version>${paper.version}</version>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>io.github.toxicity188</groupId>
      <artifactId>bettermodel-bukkit-api</artifactId>
      <version>${bettermodel.version}</version>
      <scope>provided</scope>
    </dependency>

    <!--
      PlaceholderAPI. 선택적 연동이지만 DiscordSRV 와 달리 컴파일 의존을 건다 —
      PlaceholderExpansion 을 상속해야 해서 리플렉션으로는 등록조차 못 한다.
      대신 provided 라 jar 에 들어가지 않고, PlaceholderAPI 가 없는 서버에서는
      확장을 등록하지 않는다 (PetPlaceholders.register 가 먼저 확인한다).
    -->
    <dependency>
      <groupId>me.clip</groupId>
      <artifactId>placeholderapi</artifactId>
      <version>${placeholderapi.version}</version>
      <scope>provided</scope>
      <exclusions>
        <!-- 이 둘은 paper-api 가 이미 준다. 버전이 갈리면 컴파일이 흔들린다. -->
        <exclusion>
          <groupId>org.spigotmc</groupId>
          <artifactId>spigot-api</artifactId>
        </exclusion>
        <exclusion>
          <groupId>org.bukkit</groupId>
          <artifactId>bukkit</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <!-- 저장소 의존성은 M3 에서 추가한다. 지금 넣지 않는 이유는 아래 build 주석 참고. -->

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>${project.name}-${project.version}</finalName>

    <resources>
      <!-- paper-plugin.yml 만 ${project.version} 치환을 받는다 -->
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
        <includes>
          <include>paper-plugin.yml</include>
        </includes>
      </resource>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>false</filtering>
        <excludes>
          <exclude>paper-plugin.yml</exclude>
        </excludes>
      </resource>
    </resources>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.14.0</version>
        <configuration>
          <compilerArgs>
            <arg>-parameters</arg>
            <arg>-Xlint:all,-processing</arg>
          </compilerArgs>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
      </plugin>

      <!--
        M3(저장소)에서 외부 라이브러리를 들일 때 읽을 것 — 실측으로 확인한 두 가지:

        1) maven-shade-plugin 은 반드시 3.6.2 이상을 쓴다.
           3.6.0 은 번들 ASM 이 낡아 Java 25 클래스(major 69)를 읽지 못하고
           "Unsupported class file major version 69" 로 패키징 단계에서 실패한다.

        2) 그런데 셰이딩보다 Paper 의 라이브러리 로더가 낫다.
           sqlite-jdbc 를 셰이딩했더니 전 플랫폼 네이티브가 딸려와 jar 가
           15KB -> 14MB 로 불었다. Paper 는 플러그인별로 클래스로더를 격리해
           라이브러리를 받아주므로 재배치(relocation)도 필요 없다.
           paper-plugin.yml 에서는 PluginLoader 를 지정하는 방식이다.
      -->
    </plugins>
  </build>
</project>
